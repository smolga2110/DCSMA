{
  "openapi": "3.0.3",
  "info": {
    "title": "Nobel Prize API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "Получение JWT",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "student"
                  },
                  "password": {
                    "type": "string",
                    "example": "Student123!"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/prizes": {
      "get": {
        "summary": "Список премий",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/prizes/{year}/{category}": {
      "get": {
        "summary": "Сведения о премии",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/prizes/{year}/{category}/laureates": {
      "get": {
        "summary": "Сведения о премии",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/users/me": {
      "get": {
        "summary": "Текущий пользователь",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me/prizes": {
      "get": {
        "summary": "Избранные премии",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me/prizes/{prizeId}": {
      "post": {
        "summary": "Изменение избранного",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "prizeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "summary": "Изменение избранного",
        "responses": {
          "200": {
            "description": "Успешный ответ"
          },
          "400": {
            "description": "Некорректный запрос"
          },
          "401": {
            "description": "Нужен JWT"
          },
          "404": {
            "description": "Не найдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "prizeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
